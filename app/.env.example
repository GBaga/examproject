# MongoDB Atlas connection string (Vercel → Settings → Environment Variables)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
# სურვილისამებრ: ბაზის სახელი (ნაგულისხმევი: logistics)
MONGODB_DB=logistics
# სესიის ტოკენების ხელმოწერის გასაღები: openssl rand -hex 32
AUTH_SECRET=change-me
